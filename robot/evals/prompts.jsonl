{"id": "e07", "prompt": "Front vertical drisk like Revron, forks, 2WD.", "expected": {"weapon": {"type": "vspin_drisk", "mount": "front", "attachment": "drisk"}, "front": "forks", "drive": {"layout": "2WD", "transmission": "direct"}, "chassis": "clamshell"}, "expect_ok": true}
{"id": "e08", "prompt": "Vertical drisk with wedgelets instead of forks.", "expected": {"weapon": {"type": "vspin_drisk", "mount": "front", "attachment": "drisk"}, "front": "wedgelets"}, "expect_ok": true}
