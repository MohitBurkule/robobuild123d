{"id": "e01", "prompt": "A 2WD wedge pusher, nothing fancy.", "expected": {"weapon": {"type": "wedge"}, "front": "wedge", "drive": {"layout": "2WD", "transmission": "direct"}}, "expect_ok": true}
{"id": "e02", "prompt": "Simple pusher robot with a plow front.", "expected": {"weapon": {"type": "none_pusher"}, "front": "plow", "drive": {"layout": "2WD"}}, "expect_ok": true}
