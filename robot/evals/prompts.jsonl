{"id": "e05", "prompt": "Horizontal bar spinner on top, hub motor, wedgelets.", "expected": {"weapon": {"type": "hspin_bar", "mount": "top", "attachment": "hub_motor"}, "front": "wedgelets"}, "expect_ok": true}
