  },
  {
   "a": "bar",
   "b": "weapon_hub",
   "method": "screw",
   "reason": "2x M3 csk through the bar into the hub's tapped holes"
  },
  {
   "a": "weapon_hub",
   "b": "weapon_motor_bell",
   "method": "screw",
   "reason": "4x M2 csk through bar + hub into the bell's top holes: the bell drives the whole rotor stack",
   "mechanical_key": true
  },
  {
   "a": "skid_foot",
   "b": "wshaft",
   "method": "thread",
   "reason": "POM cap tapped M5 on the shaft's threaded end: it spins with the bar and sets the 2 mm bar height",
