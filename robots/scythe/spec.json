   "interference_mm": 0.05,
   "mechanical_key": true
  },
  {
   "a": "drive_motor_r",
   "b": "tub",
   "method": "interlock",
   "reason": "gearmotor seats on its printed cradle pads, the ribs locate it fore-aft and the pod wall takes the gearbox face; the wheel on the shaft clamps the assembly"
  },
